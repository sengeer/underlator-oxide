# HTTP mode against underlator-server.
# Canonical setup is the same-origin compose stack on :8080 (token is baked in at Dockerfile build time).
# This file is for local Vite (:8000) with a proxy to :8080.

VITE_BACKEND_MODE=http
# Empty = same-origin / Vite proxy (`/api`, `/healthz` → 127.0.0.1:8080).
VITE_BACKEND_URL=
# Shared secret = UNDERLATOR_AUTH_TOKEN from compose (dev default).
VITE_BACKEND_TOKEN=dev-change-me

# Testing/diagnostics panel.
# Keep it "false" (or unset) for the prod build.
VITE_SHOW_TESTS=false